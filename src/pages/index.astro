---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const episodes = (await getCollection('podcast')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

function formatDuration(seconds: number) {
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  return h > 0 ? `${h}h ${m}m` : `${m}m`;
}
---
<Layout title="Better World With Design — Podcast">
  <h1 style="font-size: 2.1rem; margin-bottom: 0.25rem;">Every episode</h1>
  <p style="color: var(--warm-gray); margin-top: 0; margin-bottom: 2.5rem;">
    Design, music, photography, and the arts — {episodes.length} episodes and counting.
  </p>

  <ul style="list-style: none; padding: 0; margin: 0;">
    {episodes.map((ep) => (
      <li style="display: flex; gap: 1.25rem; padding: 1.25rem 0; border-bottom: 1px solid var(--parchment-dark);">
        <img
          src={ep.data.imageUrl}
          alt=""
          width="72"
          height="72"
          style="border-radius: 4px; object-fit: cover; flex-shrink: 0; border: 1px solid var(--parchment-dark);"
          loading="lazy"
        />
        <div style="min-width: 0;">
          <div style="font-size: 0.75rem; color: var(--brass); font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase;">
            Episode {ep.data.episodeNumber}
          </div>
          <h2 style="font-size: 1.1rem; margin: 0.15rem 0 0.35rem; line-height: 1.3;">
            <a href={`/podcast/${ep.slug}`} style="text-decoration: none; color: var(--ink);">
              {ep.data.title}
            </a>
          </h2>
          <div style="font-size: 0.85rem; color: var(--warm-gray);">
            {new Date(ep.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            {' · '}{formatDuration(ep.data.durationSeconds)}
          </div>
        </div>
      </li>
    ))}
  </ul>
</Layout>
