---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Better World With Design — a podcast on design, music, and creative growth." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Optimized Preconnect & Font Loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link 
    rel="preload" 
    as="style" 
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" 
  />
  <link 
    rel="stylesheet" 
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" 
    media="print" 
    onload="this.media='all'" 
  />

  <style>
    :root {
      --ink: #1c2b33;
      --forest: #2f4538;
      --parchment: #e9e2d3;
      --parchment-dark: #ded4bf;
      --warm-gray: #4a443b;
      --brass: #7a5518;
      --brass-decorative: #a8834a;
      --font-display: "Fraunces", serif;
      --font-body: "Source Serif 4", serif;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--parchment);
      color: var(--ink);
      font-family: var(--font-body);
      line-height: 1.6;
    }
    a { color: var(--forest); text-decoration-thickness: 1px; }
    .wrap {
      max-width: 760px;
      margin: 0 auto;
      padding: 3rem 1.5rem 5rem;
    }
    .masthead {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-bottom: 2px solid var(--ink);
      padding-bottom: 0.75rem;
      margin-bottom: 2.5rem;
    }
    .masthead a {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--ink);
      text-decoration: none;
      letter-spacing: 0.01em;
    }
    .masthead span {
      font-size: 0.8rem;
      color: var(--warm-gray);
      font-style: italic;
    }
    h1, h2, h3 { font-family: var(--font-display); color: var(--ink); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="masthead">
      <a href="/">Better World With Design</a>
      <span>the podcast</span>
    </div>
    <main>
      <slot />
    </main>
  </div>
</body>
</html>