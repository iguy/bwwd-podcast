---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Better World With Design — Podcast",
  description = "A podcast on design, music, and creative growth."
} = Astro.props;

// GA4 Measurement ID for betterworldwithdesign.com & subdomains
const GA_MEASUREMENT_ID = 'G-02EPG8KK2Y';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Analytics 4 (Only loaded in production deployments) -->
    {import.meta.env.PROD && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
  </head>
  <body>
    <div class="wrap">
      <header class="masthead">
        <a href="/">Better World With Design</a>
        <span>the podcast</span>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1c2b33;
    --forest: #2f4538;
    --parchment: #e9e2d3;
    --parchment-dark: #ded4bf;
    --warm-gray: #4a443b;
    --brass: #7a5518;
    --brass-decorative: #a8834a;
    --font-display: "Fraunces", serif;
    --font-body: "Source Serif 4", serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--parchment);
    color: var(--ink);
    font-family: var(--font-body);
    line-height: 1.6;
  }

  a {
    color: var(--forest);
    text-decoration-thickness: 1px;
  }

  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .masthead a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .masthead span {
    font-size: 0.8rem;
    color: var(--warm-gray);
    font-style: italic;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    color: var(--ink);
  }
</style>