---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Better World With Design — a podcast on design, music, and creative growth." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=Caveat:wght@600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #1c2b33;
      --deep-blue: #1e3a4c;
      --forest: #2f4538;
      --parchment: #ece4d2;
      --parchment-dark: #d9cdb2;
      --warm-gray: #4a443b;
      --brass: #7a5518;
      --brass-decorative: #a8834a;
      --font-display: "Fraunces", serif;
      --font-body: "Source Serif 4", serif;
      --font-hand: "Caveat", cursive;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      font-family: var(--font-body);
      line-height: 1.6;
      background-color: var(--parchment);
      background-image:
        radial-gradient(circle at 20% 20%, rgba(0,0,0,0.025) 0%, transparent 45%),
        radial-gradient(circle at 80% 60%, rgba(0,0,0,0.02) 0%, transparent 40%);
    }
    a { color: var(--forest); }
    .wrap {
      max-width: 780px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 5rem;
    }
    .masthead {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-bottom: 3px double var(--ink);
      padding-bottom: 0.85rem;
      margin-bottom: 2rem;
    }
    .masthead a {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.2rem;
      color: var(--ink);
      text-decoration: none;
      letter-spacing: 0.01em;
    }
    .masthead span {
      font-family: var(--font-hand);
      font-size: 1.35rem;
      color: var(--deep-blue);
      transform: rotate(-2deg);
      display: inline-block;
    }
    h1, h2, h3 { font-family: var(--font-display); color: var(--ink); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="masthead">
      <a href="/">Better World With Design</a>
      <span>the podcast</span>
    </div>
    <main>
      <slot />
    </main>
  </div>
</body>
</html>
